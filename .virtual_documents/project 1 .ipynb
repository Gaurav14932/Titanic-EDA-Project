import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns


df = pd.read_csv('train.csv')


df.head()


df.info()


df.describe()



df.isnull()


df.isnull().sum()


df["Age"].fillna(df["Age"].mean())


df.drop('Cabin', axis=1, inplace=True)


most_embarked = df['Embarked'].mode()[0]#most frequent value that use to fill missing values
df['Embarked'].fillna(most_embarked)


df.drop(['Ticket', 'Name'], axis=1)


df['FamilySize'] = df['SibSp'] + df['Parch'] + 1 


df['IsAlone'] = 0
df.loc[df['FamilySize'] == 1, 'IsAlone'] = 1


df.info()


df.describe()


df


Survived=df["Survived"]


Survived


Familysize=df["FamilySize"]


sns.set_style('whitegrid')

plt.figure(figsize=(10, 6))
sns.histplot(df['Age'], kde=True, bins=30)
plt.title('Age Distribution of Passengers')
plt.xlabel('Age')
plt.ylabel('Count')
plt.show()


plt.figure(figsize=(4, 5))
sns.countplot(x='Pclass', data=df)
plt.title('Passenger Count by Pclass')
plt.xlabel('Passenger Class')
plt.ylabel('Count')
plt.show()



plt.figure(figsize=(4, 5))
sns.barplot(x='Sex', y='Survived', data=df)
plt.title('Survival Rate by Gender')
plt.xlabel('Gender')
plt.ylabel('Survival Rate')
plt.show()


plt.figure(figsize=(4, 5))
sns.barplot(x='Pclass', y='Survived', data=df)
plt.title('Survival Rate by Passenger Class')
plt.xlabel('Passenger Class')
plt.ylabel('Survival Rate')
plt.show()



plt.figure(figsize=(10, 6))
sns.barplot(x='FamilySize', y='Survived', data=df)
plt.title('Survival Rate by Family Size')
plt.xlabel('Family Size')
plt.ylabel('Survival Rate')
plt.show()


plt.figure(figsize=(15, 8))
corr_matrix = df.corr(numeric_only=True)
sns.heatmap(corr_matrix, annot=True, cmap='binary', fmt=".2f")
plt.title('Correlation Heatmap of Features')
plt.show()



"""Based on the correlation heatmap, here are the key conclusions you can draw:

Strongest Correlations with Survival
The feature with the strongest correlation to survival is Fare. The positive correlation of 0.26 indicates 
that passengers who paid a higher fare had a slightly higher chance of surviving. PClass (passenger class)
has the strongest negative correlation with survival at -0.34, which suggests that passengers in lower 
classes were less likely to survive. This makes sense, as higher fares and PClass are likely related."""



